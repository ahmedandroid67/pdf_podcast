# PdfPodcaster Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Required ---

# Google Gemini API key for AI summarization and podcast generation
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/pdfpodcaster

# Secret key for signing JWT tokens (generate a strong random string)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Optional: Google OAuth2 (for social login) ---

# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 redirect URI (must match Google Cloud Console setting)
# e.g. http://localhost:8000/auth/callback/google
REDIRECT_URI=http://localhost:8000/auth/callback/google

# Frontend URL for OAuth redirects
# e.g. http://localhost:5173 (dev) or https://your-domain.com (prod)
FRONTEND_URL=http://localhost:5173

# --- Optional: Session & Debug ---

# Separate secret for session middleware (defaults to JWT_SECRET_KEY if not set)
SESSION_SECRET_KEY=

# Set to "true" to enable verbose error traces in API responses (development only)
DEBUG=false

# --- Additional Config ---

# JWT algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# JWT expiration in minutes (default: 120)
# JWT_EXPIRES_MINUTES=120

# Comma-separated list of allowed CORS origins (default: *)
# CORS_ORIGINS=*
